# Copy this file, rename the copy to .env, and fill in your own values.
# Never share your real .env file: it can contain passwords.

# DRYRUN = safe testing: emails are saved as text files in email_previews
# SMTP = send through Gmail (needs the two Gmail settings below)
# OUTLOOK = send through the classic Outlook desktop app (Windows)
SEND_MODE=DRYRUN

# Only needed for SMTP mode (use a Gmail App Password, not your normal password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# If filled in, ALL emails go to this address. Use it while testing.
TEST_RECIPIENT=

# Optional: the location shown in the emails (default: the workbook's path)
TRACKER_LOCATION=

# Where the report PDF comes from: FOLDER (already in incoming), IMAP (Gmail), OUTLOOK
PICKUP_MODE=FOLDER

# Which email is the Looker report (leave empty to accept any email)
LOOKER_SENDER=
LOOKER_SUBJECT=